rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectManager(projectId) {
      return isAuthenticated() && (
        request.auth.uid == resource.data.managerId ||
        request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.managerId
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // User records cannot be deleted directly
    }

    // 2. Projects collection: Strictly isolated to the project manager/creator
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.managerId == request.auth.uid ||
        resource.data.ownerContact == request.auth.token.email
      );
      allow create: if isAuthenticated() && request.resource.data.managerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.managerId == request.auth.uid;
    }

    // 3. Permits collection: Scoped to the project owner
    match /permits/{permitId} {
      allow read, write: if isAuthenticated() && isProjectManager(resource.data.projectId);
      allow create: if isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.managerId
      );
    }

    // 4. Requirements & Documents collections
    match /requirements/{requirementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedById == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uploadedById == request.auth.uid;
    }

    // 5. Validation results: Read-only for project members, created by verification engine
    match /validationResults/{resultId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // 6. Professional Reviews: Enforces licensed reviewer credentials
    match /professionalReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.registrationNumber != null;
      allow update, delete: if false; // Signed professional endorsements are immutable
    }

    // 7. Applications & Tracking
    match /applications/{applicationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // 8. Audit Logs & Timeline Events: Append-only audit trail
    match /timelineEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.changedById == request.auth.uid;
      allow update, delete: if false; // Audit logs are tamper-proof and immutable
    }
  }
}
